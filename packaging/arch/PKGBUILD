# Maintainer: Yuvraj Talukdar
#
# GETH — Geth Engine for Tracking Hardware
#
# Build model:
#   * The GETH source is a tarball of the exact commit being packaged.
#     tools/package-arch.sh creates it with `git archive` and stages it
#     next to this PKGBUILD; the geth tarball itself has no fetch URL or
#     checksum (it is generated per build, from the commit).
#   * All third-party dependencies are pinned tarballs with checksums,
#     extracted by makepkg BEFORE build(). build() points CMake at them via
#     FETCHCONTENT_SOURCE_DIR_*, so build() performs NO network access.
#
# `pkgver` must equal the CMake project version; both build() (here) and
# tools/package-arch.sh check that, and a mismatch fails the build.
# `license` must equal CMake's GETH_LICENSE; the packaging script checks it.

pkgname=geth
pkgver=1.5.2
pkgrel=1
pkgdesc="A fast, lightweight terminal system monitor for Linux (C++20, in-process, no subprocesses)"
url="https://github.com/YuvrajTalukdar/geth"
arch=(x86_64)
license=(MIT)
depends=(gcc-libs glibc zlib)
optdepends=(
  'nvidia-utils: NVIDIA GPU monitoring via NVML (dlopened at runtime, never linked)'
)
makedepends=(cmake git zlib)

# The GETH tarball (created by tools/package-arch.sh from the commit) plus
# the pinned, checksummed dependency tarballs.
source=(
  "geth-${pkgver}.tar.gz"
  "ftxui-6.1.9.tar.gz::https://github.com/ArthurSonzogni/FTXUI/archive/refs/tags/v6.1.9.tar.gz"
  "tomlplusplus-3.4.0.tar.gz::https://github.com/marzer/tomlplusplus/archive/refs/tags/v3.4.0.tar.gz"
  "doctest-2.4.11.tar.gz::https://github.com/doctest/doctest/archive/refs/tags/v2.4.11.tar.gz"
)
sha256sums=(
  "SKIP"
  "45819c1e54914783d4a1ca5633885035d74146778a1f74e1213cdb7b76340e71"
  "8517f65938a4faae9ccf8ebb36631a38c1cadfb5efa85d9a72e15b9e97d25155"
  "632ed2c05a7f53fa961381497bf8069093f0d6628c5f26286161fbd32a560186"
)

# CMake's project version, extracted from the tarball's CMakeLists.txt
# (project() and VERSION may sit on different lines).
_cmake_version() {
  grep -A4 '^project(geth' "$srcdir/geth-${pkgver}/CMakeLists.txt" \
    | grep -m1 -oE 'VERSION [0-9]+(\.[0-9]+)*' | awk '{print $2}'
}

# CMake's GETH_LICENSE, extracted the same way.
_cmake_license() {
  sed -n 's/^set(GETH_LICENSE[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$srcdir/geth-${pkgver}/CMakeLists.txt" | head -n1
}

build() {
  cd "$srcdir/geth-${pkgver}"

  # pkgver must match the CMake project version; a mismatch fails the build.
  local cmake_ver
  cmake_ver="$(_cmake_version)"
  if [[ "$cmake_ver" != "$pkgver" ]]; then
    echo "geth: version mismatch: CMakeLists.txt is $cmake_ver, PKGBUILD pkgver is $pkgver" >&2
    exit 1
  fi
  # license= must match CMake's GETH_LICENSE.
  local cmake_lic
  cmake_lic="$(_cmake_license)"
  if [[ "$cmake_lic" != "${license[0]}" ]]; then
    echo "geth: license mismatch: CMakeLists.txt is $cmake_lic, PKGBUILD license is ${license[0]}" >&2
    exit 1
  fi

  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFETCHCONTENT_SOURCE_DIR_FTXUI="$srcdir/FTXUI-6.1.9" \
    -DFETCHCONTENT_SOURCE_DIR_TOMLPLUSPLUS="$srcdir/tomlplusplus-3.4.0" \
    -DFETCHCONTENT_SOURCE_DIR_DOCTEST="$srcdir/doctest-2.4.11"
  cmake --build build -j"$(nproc)"
}

check() {
  # GETH_TEST=1: the in-app guard refuses any config write under the real
  # ~/.config, so a regression in the test suite can never touch the
  # package builder's home directory.
  cd "$srcdir/geth-${pkgver}"
  GETH_TEST=1 ctest --test-dir build --output-on-failure
}

package() {
  cd "$srcdir/geth-${pkgver}"
  # DESTDIR keeps CMAKE_INSTALL_PREFIX=/usr baked in at configure time.
  DESTDIR="${pkgdir}" cmake --install build
}
